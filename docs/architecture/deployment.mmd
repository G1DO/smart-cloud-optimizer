    subgraph BackendC["backend service<br/>image optimizer-backend<br/>python:3.12-slim + uvicorn :8000"]
      BE["FastAPI backend_api.main:app<br/>--host 0.0.0.0 --port 8000<br/>lifespan ensure_schema<br/>Health GET /health"]
