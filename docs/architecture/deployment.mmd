    subgraph FrontendC["frontend service<br/>image optimizer-frontend<br/>Next.js :3000"]
      FE["Next.js UI<br/>NEXT_PUBLIC_API_BASE_URL build arg<br/>http://localhost:8000 host-reachable<br/>depends_on backend healthy"]
    end
    subgraph StreamlitC["streamlit service<br/>profile full only<br/>Reuses optimizer-backend image"]
      ST["Streamlit dashboard/app.py :8501<br/>--server.address 0.0.0.0<br/>depends_on backend healthy"]
    end
  end

  Vol[("Named volume optimizer-data<br/>Mounted at /app/data<br/>Seeded from image, appuser uid 10001<br/>SQLite WAL writable<br/>down -v resets demo DB")]
