GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_MODEL=gemini-2.5-flash
# Legacy display/reference values, not boto3 targeting. For live collection,
# configure boto3 credentials and AWS_DEFAULT_REGION; see documentation/CONFIGURATION.md.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=SYNTHETIC-001
DEMO_MODE=true  # legacy Streamlit status label; does not control data collection
# Optional X-API-Token gate on /api/ai-onboarding/generate only.
# Keep the comment on its own line so dotenv reads an empty value.
ONBOARDING_API_TOKEN=
