# Environment for docker compose. Copy to `.env` (same dir as docker-compose.yml)
# and fill in values:  cp .env.docker.example .env
# All vars are optional for localhost exploration with the existing demo data.

# Legacy Streamlit status label. This value does not select data or control
# collection through the CLI or FastAPI.
DEMO_MODE=true

# Google Gemini API key for AI architecture recommendations. Empty = AI
# onboarding generation returns HTTP 502; the rest of the app works fine.
GOOGLE_API_KEY=

# Gemini model id used by ai_module.
GOOGLE_MODEL=gemini-2.5-flash

# AWS targeting (defaults match the shipped synthetic account).
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=SYNTHETIC-001

# Optional gate for POST /api/ai-onboarding/generate. If set, requests must send
# a matching X-API-Token header; the current Next.js UI does not send this header.
ONBOARDING_API_TOKEN=

# Base boto3 credentials for CLI collection or legacy sts:AssumeRole connections.
# The primary web UI submits access keys directly to the backend for testing
# and storage. Leave these empty when using only the synthetic workspace.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# NOTE: NEXT_PUBLIC_API_BASE_URL is NOT a backend runtime var. It is a frontend
# BUILD arg (set in docker-compose.yml under frontend.build.args) because Next.js
# inlines NEXT_PUBLIC_* values into the browser bundle at build time. It must be
# a host-reachable URL (default http://localhost:8000), not the "backend"
# service name.
